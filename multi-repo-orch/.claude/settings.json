{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactWindow": 250000,
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/*)",
      "Bash(npx vitest run *)",
      "Bash(npm run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git -C *)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Bash(git push --force*)"
    ]
  },
  "sandbox": {
    "network": { "allowLocalBinding": true }
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/cost-tap.sh"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/cost-banner.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/resume-state.sh" }
        ]
      }
    ]
  }
}
